# MongoDB connection (local or Atlas)
# App uses database name "cortexly" (see lib/db.ts). Path in URI is ignored for getDatabase().
MONGODB_URI=your_mongodb_connection_string

# JWT signing secret (use a long random string in production)
JWT_SECRET=your_jwt_secret

# Public URL of the app (used in share links + Stripe redirects).
# Example production: https://cortexly.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe billing (optional locally — Free plan limits still apply)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
# Optional enterprise price; otherwise enterprise is sales-assisted
# STRIPE_PRICE_ENTERPRISE=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
