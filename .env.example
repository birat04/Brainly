# MongoDB connection (local or Atlas)
# App uses database name "cortexly" (see lib/db.ts). Path in URI is ignored for getDatabase().
MONGODB_URI=your_mongodb_connection_string

# JWT signing secret (use a long random string in production)
JWT_SECRET=your_jwt_secret

# Public URL of the app (used in share links). Update after Vercel/domain rename.
# Example production: https://cortexly.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
